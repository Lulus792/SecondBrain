# Native AT-SPI Table/TableCell on the pinned UI sources, preserving the lockfile.
function(sb_table_source path original patched output)
    file(SHA256 "${path}" digest)
    if(NOT digest STREQUAL original AND NOT digest STREQUAL patched)
        message(FATAL_ERROR "Unrecognized AccessKit table source: ${path}; refusing an unverified patch")
    endif()
    set(${output} "${digest}" PARENT_SCOPE)
endfunction()
set(node "${SB_ATSPI_SOURCE}/src/node.rs")
set(filters "${SB_ATSPI_SOURCE}/src/filters.rs")
set(modules "${SB_UNIX_SOURCE}/src/atspi/interfaces/mod.rs")
set(bus "${SB_UNIX_SOURCE}/src/atspi/bus.rs")
sb_table_source("${node}" "32f8e038ed152668c190a3acd672485b60e0e9c9abd017fc746bf3d502c47dd1" "cdb02d7b49d51b74f2933f7a8905eee6e46b9b77300d1e8dc8963366469f46e5" node_hash)
sb_table_source("${filters}" "cfe74d16da43ccfda209f11107faf78442c6830fa126cf2d48ffdcdf14c65288" "fffbde7977e33137b80c34698540b9836190a7a7c6cef233b0e7ded5dcc8fd0c" filter_hash)
sb_table_source("${modules}" "a3f7875a51c3f69de9a6cbbf03044fa588270d6095c00446525308d84a5172fb" "956ce1f272c3b69d9edbea092221c3f5f8b645f281f01299a71e678ee20cd4dc" module_hash)
sb_table_source("${bus}" "52ff001b67b5121afe964bb745132ece5648ae367744cec0a87edd12281ffdf8" "9e75f7c7ce60fcca1ec2ad46dda85b38371367b3c7ce540e04bd3f4b84597859" bus_hash)
if(node_hash STREQUAL "32f8e038ed152668c190a3acd672485b60e0e9c9abd017fc746bf3d502c47dd1")
    file(READ "${node}" text)
    string(REPLACE "        interfaces\n    }" "        if self.sb_supports_table() { interfaces.insert(Interface::Table); }\n        if self.sb_supports_table_cell() { interfaces.insert(Interface::TableCell); }\n        interfaces\n    }" text "${text}")
    string(APPEND text "\ninclude!(\"secondbrain_table.rs\");\n")
    file(CONFIGURE OUTPUT "${node}" CONTENT "${text}" @ONLY NEWLINE_STYLE UNIX)
endif()
if(filter_hash STREQUAL "cfe74d16da43ccfda209f11107faf78442c6830fa126cf2d48ffdcdf14c65288")
    file(READ "${filters}" text)
    string(REPLACE "pub(crate) use accesskit_consumer::common_filter as filter;" "include!(\"secondbrain_table_filter.rs\");" text "${text}")
    file(CONFIGURE OUTPUT "${filters}" CONTENT "${text}" @ONLY NEWLINE_STYLE UNIX)
endif()
if(module_hash STREQUAL "a3f7875a51c3f69de9a6cbbf03044fa588270d6095c00446525308d84a5172fb")
    file(READ "${modules}" text)
    string(APPEND text "\nmod secondbrain_table;\npub(crate) use secondbrain_table::*;\n")
    file(CONFIGURE OUTPUT "${modules}" CONTENT "${text}" @ONLY NEWLINE_STYLE UNIX)
endif()
if(bus_hash STREQUAL "52ff001b67b5121afe964bb745132ece5648ae367744cec0a87edd12281ffdf8")
    file(READ "${bus}" text)
    string(REPLACE "        if new_interfaces.contains(Interface::Value) {" "        if new_interfaces.contains(Interface::Table) { self.register_interface(&path,TableInterface::new(bus_name.clone(),node.clone())).await?; }\n        if new_interfaces.contains(Interface::TableCell) { self.register_interface(&path,TableCellInterface::new(bus_name.clone(),node.clone())).await?; }\n        if new_interfaces.contains(Interface::Value) {" text "${text}")
    string(REPLACE "        if old_interfaces.contains(Interface::Value) {" "        if old_interfaces.contains(Interface::Table) { self.unregister_interface::<TableInterface>(&path).await?; }\n        if old_interfaces.contains(Interface::TableCell) { self.unregister_interface::<TableCellInterface>(&path).await?; }\n        if old_interfaces.contains(Interface::Value) {" text "${text}")
    file(CONFIGURE OUTPUT "${bus}" CONTENT "${text}" @ONLY NEWLINE_STYLE UNIX)
endif()
foreach(pair IN ITEMS "node;cdb02d7b49d51b74f2933f7a8905eee6e46b9b77300d1e8dc8963366469f46e5" "filters;fffbde7977e33137b80c34698540b9836190a7a7c6cef233b0e7ded5dcc8fd0c" "modules;956ce1f272c3b69d9edbea092221c3f5f8b645f281f01299a71e678ee20cd4dc" "bus;9e75f7c7ce60fcca1ec2ad46dda85b38371367b3c7ce540e04bd3f4b84597859")
    list(GET pair 0 name)
    list(GET pair 1 expected)
    file(SHA256 "${${name}}" digest)
    if(NOT digest STREQUAL expected)
        message(FATAL_ERROR "Unexpected result of AT-SPI table patch: ${name} / ${digest}")
    endif()
endforeach()
configure_file("${CMAKE_CURRENT_LIST_DIR}/../third_party/ui/accesskit_atspi_table.rs" "${SB_ATSPI_SOURCE}/src/secondbrain_table.rs" COPYONLY)
configure_file("${CMAKE_CURRENT_LIST_DIR}/../third_party/ui/accesskit_atspi_table_filter.rs" "${SB_ATSPI_SOURCE}/src/secondbrain_table_filter.rs" COPYONLY)
configure_file("${CMAKE_CURRENT_LIST_DIR}/../third_party/ui/accesskit_unix_table.rs" "${SB_UNIX_SOURCE}/src/atspi/interfaces/secondbrain_table.rs" COPYONLY)
