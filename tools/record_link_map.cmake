cmake_minimum_required(VERSION 3.20)
if(NOT SB_PROGRAM OR NOT SB_MAP OR NOT EXISTS "${SB_PROGRAM}" OR NOT EXISTS "${SB_MAP}")
    message(FATAL_ERROR "Program and its completed link map are required")
endif()
file(SIZE "${SB_MAP}" SB_MAP_SIZE)
if(SB_MAP_SIZE EQUAL 0)
    message(FATAL_ERROR "Link map is empty")
endif()
file(SHA256 "${SB_PROGRAM}" SB_PROGRAM_HASH)
file(SHA256 "${SB_MAP}" SB_MAP_HASH)
if(SB_LINK_INPUTS)
    if(NOT EXISTS "${SB_LINK_INPUTS}")
        message(FATAL_ERROR "Completed linker input-path list is required")
    endif()
    file(SIZE "${SB_LINK_INPUTS}" SB_LINK_INPUTS_SIZE)
    if(SB_LINK_INPUTS_SIZE EQUAL 0)
        message(FATAL_ERROR "Linker input-path list is empty")
    endif()
    file(SHA256 "${SB_LINK_INPUTS}" SB_LINK_INPUTS_HASH)
    file(WRITE "${SB_LINK_INPUTS}.identity"
        "SecondBrain link inputs 1\nprogram_sha256=${SB_PROGRAM_HASH}\ninputs_sha256=${SB_LINK_INPUTS_HASH}\n")
endif()
file(WRITE "${SB_MAP}.identity"
    "SecondBrain link map 1\nprogram_sha256=${SB_PROGRAM_HASH}\nmap_sha256=${SB_MAP_HASH}\n")
